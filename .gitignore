__pycache__/
*.py[cod]
*.log
*.egg-info/
.pytest_cache/
.cache/
.torch_extensions/
outputs/
/experiments/svdquant/*/model/
checkpoints/
*.safetensors
*.pth
*.pt
rank*/
evaluation*/images/
evaluation*/rank*/
data/mjhq_fid_reference
third_party/deepcompressor/examples/diffusion/datasets/
third_party/deepcompressor/examples/diffusion/runs/
third_party/deepcompressor/examples/diffusion/cache/
/data/
/experiments/mixdq/*/hf_cache/
.env

# Required, small MixDQ mixed-precision allocation artifact.
!third_party/mixdq/mixed_precision_scripts/mixed_percision_config/sdxl_turbo/final_config/act/*.pt

# Keep small DeepCompressor checkpoint metadata needed by tests/loaders while
# continuing to ignore model weights and generated binaries.
!/experiments/svdquant/*/model/
!/experiments/svdquant/*/model/*/
!/experiments/svdquant/*/model/*/deepcompressor_config.json

# Installed by scripts/prepare_paper_artifacts.py
/experiments/*/*/calibration_pooled_1000/
/experiments/svdquant/sdxl_w3a4_ptqd/calibration/
/experiments/mixdq/sdxl-turbo_w4a8/mixdq_qdiff_ckpt/ckpt.pth
/licenses/
/experiments/svdquant/*/model/*/deepcompressor_model_config.yaml
/experiments/svdquant/sdxl_w3a4_k10_subsets/outputs/
/experiments/mixdq/*/cache/

# Generated evaluation outputs
/experiments/*/*/evaluation*/
/experiments/svdquant/sdxl_w3a4_studies/

# Local artifact bundles (not part of the release)
/artifacts/

# DeepCompressor calibration caches written by STAGE=quantize
/datasets/
